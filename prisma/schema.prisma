enum MessageAuthorKind {
  lawyer
  client
}

/// Conversa do caso entre o escritório e o cliente do portal. `Note` continua
/// existindo e é **interna**: nunca sai para o portal. Foi por não haver essa
/// separação que as notas do advogado chegaram a ser servidas ao cliente.
model Message {
  id             String            @id @default(cuid())
  caseId         String
  authorKind     MessageAuthorKind
  userId         String?
  clientId       String?
  body           String
  createdAt      DateTime          @default(now())
  deletedAt      DateTime?
  readByClientAt DateTime?
  readByLawyerAt DateTime?

  case        Case                @relation(fields: [caseId], references: [id])
  user        User?               @relation(fields: [userId], references: [id])
  client      Client?             @relation(fields: [clientId], references: [id])
  attachments MessageAttachment[]

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([caseId, createdAt])
  @@index([caseId, readByLawyerAt])
  @@index([caseId, readByClientAt])
  @@index([organizationId])
}

/// Anexo de mensagem. Aponta para o `Document` que já existe em vez de guardar
/// arquivo próprio: upload assinado, download e expurgo já são resolvidos lá, e
/// um segundo caminho de arquivo duplicaria permissão e storage.
model MessageAttachment {
  id         String @id @default(cuid())
  messageId  String
  documentId String @unique

  message  Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([messageId])
  @@index([organizationId])
}

