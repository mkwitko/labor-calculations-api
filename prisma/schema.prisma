generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Conexão direta (sem -pooler) para o CLI: migrate/db pull precisam de
  // advisory lock session-scoped, que o pooler do Neon não sustenta.
  directUrl = env("DIRECT_URL")
}

model User {
  id        String    @id @default(cuid())
  name      String
  document  String    @unique
  mail      String    @unique
  password  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  isAdmin Boolean @default(false)

  oabNumber String  @unique
  bio       String?

  remindD3 Boolean @default(true)
  remindD1 Boolean @default(true)

  // Nudges de onboarding. Nomes distintos de remindD1/remindD3, que são as
  // preferências de aviso de prazo e audiência: o "D" ali é dias antes do
  // compromisso, aqui é dias depois do cadastro.
  onbNudgeD1SentAt DateTime?
  onbNudgeD3SentAt DateTime?
  onbNudgeOptOut   Boolean   @default(false)

  laborCalculations LaborCalculation[]
  batchAssessments  BatchAssessment[]
  refreshTokens     RefreshToken[]
  clients           Client[]
  cases             Case[]
  notes             Note[]
  messages          Message[]
  supportTickets    SupportTicket[]
  supportMessages   SupportMessage[]
  apiKeys           ApiKey[]
  activities        Activity[]
  documentTemplates DocumentTemplate[]
  googleIntegration GoogleIntegration?
  signatureRequests SignatureRequest[]
  agendaEvents      AgendaEvent[]

  memberships Membership[]
  auditLogs   AuditLog[]

  // Referral program. `referralCode` is the perpetual public code this user
  // shares; `referralTier` is derived from how many referrals are qualified and
  // is kept in sync with the Stripe coupon applied to their subscription.
  referralCode  String?      @unique
  referralTier  ReferralTier @default(none)
  referralsMade Referral[]   @relation("referrerLink")
  referredBy    Referral?    @relation("refereeLink")
}

model Organization {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  logoUrl           String?
  letterheadUrl     String?
  brandPrimaryColor String? @default("#7e14ff")
  address           String?
  website           String?
  phone             String?

  stripeCustomerId String?
  trialEndsAt      DateTime?

  /// Contagem de membros ativos. Informativo: desde os planos por escritório a
  /// cobrança é o plano, não a quantidade de assentos.
  seats Int @default(1)

  /// Plano escolhido, no vocabulário do Stripe (`product.metadata.code`).
  /// Precisa existir antes de haver assinatura, senão a organização em trial
  /// fica sem teto de pessoas. Com assinatura viva, quem manda é o preço dela.
  planCode String @default("solo")

  /// Chave pública do widget embutível. Fica no HTML do site do escritório, por
  /// isso é opaca e rotacionável — não o id da organização. Nula = widget
  /// desligado.
  widgetKey String? @unique

  subscription Subscription?
  memberships  Membership[]
  invites      Invite[]
  auditLogs    AuditLog[]

  cases                Case[]
  clients              Client[]
  supportTickets       SupportTicket[]
  supportMessages      SupportMessage[]
  supportAttachments   SupportAttachment[]
  laborCalculations    LaborCalculation[]
  batchAssessments     BatchAssessment[]
  documentTemplates    DocumentTemplate[]
  templateVersions     DocumentTemplateVersion[]
  agendaEvents         AgendaEvent[]
  settlements          Settlement[]
  installments         SettlementInstallment[]
  documentRequirements DocumentRequirement[]
  deadlines            Deadline[]
  hearings             Hearing[]
  documents            Document[]
  notes                Note[]
  messages             Message[]
  messageAttachments   MessageAttachment[]
  apiKeys              ApiKey[]
  apiUsages            ApiUsage[]
  clientNotifications  ClientNotification[]
  caseTasks            CaseTask[]
  caseParties          CaseParty[]
  caseMovements        CaseMovement[]
  timelineEvents       TimelineEvent[]
  activities           Activity[]
  feeAgreements        FeeAgreement[]
  clientAccessTokens   ClientAccessToken[]
}

enum OrgRole {
  owner
  admin
  lawyer
  staff
  intern
}

model Membership {
  id             String    @id @default(cuid())
  userId         String
  organizationId String
  role           OrgRole   @default(lawyer)
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([userId, organizationId])
  @@index([organizationId, deletedAt])
}

enum InviteStatus {
  pending
  accepted
  revoked
  expired
}

model Invite {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  role           OrgRole      @default(lawyer)
  tokenHash      String       @unique
  status         InviteStatus @default(pending)
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, status])
}

enum SignatureStatus {
  pending
  signed
  failed
}

// A document signature request via gov.br (Assinatura Eletrônica). The user
// authorizes each signature with their own gov.br account (per-session OAuth).
model SignatureRequest {
  id            String          @id @default(cuid())
  userId        String
  caseId        String?
  documentName  String
  sourceFileKey String
  signedFileKey String?
  provider      String          @default("govbr")
  status        SignatureStatus @default(pending)
  error         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  case Case? @relation(fields: [caseId], references: [id])

  @@index([userId])
  @@index([caseId])
}

// Google Calendar OAuth integration per user (2-way sync of hearings/deadlines).
model GoogleIntegration {
  id            String   @id @default(cuid())
  userId        String   @unique
  accessToken   String
  refreshToken  String
  expiresAt     DateTime
  calendarId    String   @default("primary")
  syncHearings  Boolean  @default(true)
  syncDeadlines Boolean  @default(true)
  email         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum AgendaEventSource {
  manual
  google
}

// Personal calendar events owned by a user (not tied to a case). Powers
// standalone agenda entries and events imported from Google Calendar.
model AgendaEvent {
  id            String            @id @default(cuid())
  userId        String
  title         String
  description   String?
  location      String?
  startsAt      DateTime
  endsAt        DateTime?
  allDay        Boolean           @default(false)
  doneAt        DateTime?
  remindEmail   Boolean           @default(true)
  source        AgendaEventSource @default(manual)
  googleEventId String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([userId, googleEventId])
  @@index([userId])
  @@index([startsAt])
  @@index([organizationId])
}

model Client {
  id                 String  @id @default(cuid())
  name               String
  document           String?
  mail               String?
  phone              String?
  password           String?
  mustChangePassword Boolean @default(true)
  notes              String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  laborCalculations LaborCalculation[]
  batchAssessments  BatchAssessment[]
  cases             Case[]
  notifications     ClientNotification[]
  caseNotes         Note[]
  messages          Message[]
  accessTokens      ClientAccessToken[]

  lastLoginAt          DateTime?
  loginAttempts        Int       @default(0)
  lockedUntil          DateTime?
  notificationsEnabled Boolean   @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@index([userId, document])
  @@index([mail])
  @@index([organizationId])
}

model LaborCalculation {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id])

  clientName         String
  clientDocument     String?
  observations       String?
  calculationVersion String
  terminationType    TerminationType
  status             CalculationStatus @default(em_andamento)
  shareCode          String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Core Input
  startDate DateTime
  endDate   DateTime

  lastSalary Decimal @db.Decimal(10, 2)
  baseSalary Decimal @db.Decimal(10, 2)

  unpaid13ths           Int
  vacationCount         Int
  vacationVencidasCount Int @default(0)

  priorNoticeWorked Boolean
  priorNoticeDate   DateTime?

  extraHours Decimal @db.Decimal(10, 2)
  nightHours Decimal @db.Decimal(10, 2)

  insalubrityLevel     Int
  dangerousWork        Boolean
  applyArt477Fine      Boolean @default(false)
  lastThreeSalariesAvg Decimal @db.Decimal(10, 2)

  // Input V3
  nightAdditionalPercent Int       @default(20)
  satRate                Decimal   @default(0.03) @db.Decimal(10, 2)
  employerInssRate       Decimal   @default(0.20) @db.Decimal(10, 2)
  honorariosRate         Decimal   @default(0.15) @db.Decimal(10, 2)
  irpfDependents         Int       @default(0)
  filingDate             DateTime?
  liquidationDate        DateTime?

  // Core Result
  priorNoticeValue           Decimal @db.Decimal(10, 2)
  thirteenthSalaryValue      Decimal @db.Decimal(10, 2)
  vacationValue              Decimal @db.Decimal(10, 2)
  fgtsValue                  Decimal @db.Decimal(10, 2)
  fgtsFineValue              Decimal @db.Decimal(10, 2)
  unemploymentInsuranceValue Decimal @db.Decimal(10, 2)
  extraHoursValue            Decimal @db.Decimal(10, 2)
  nightAdditionalValue       Decimal @db.Decimal(10, 2)
  insalubrityValue           Decimal @db.Decimal(10, 2)
  dangerousWorkValue         Decimal @db.Decimal(10, 2)
  art477FineValue            Decimal @default(0) @db.Decimal(10, 2)
  totalValue                 Decimal @db.Decimal(10, 2)
  reflexo13thValue           Decimal @default(0) @db.Decimal(10, 2)
  reflexoVacationValue       Decimal @default(0) @db.Decimal(10, 2)
  reflexoFGTSValue           Decimal @default(0) @db.Decimal(10, 2)
  reflexoMultaFGTSValue      Decimal @default(0) @db.Decimal(10, 2)
  doubleVacationValue        Decimal @default(0) @db.Decimal(10, 2)

  // Result V3 
  saldoSalarioValue          Decimal @default(0) @db.Decimal(10, 2)
  correctionTotal            Decimal @default(0) @db.Decimal(10, 2)
  interestTotal              Decimal @default(0) @db.Decimal(10, 2)
  inssEmployeeValue          Decimal @default(0) @db.Decimal(10, 2)
  inssEmployerValue          Decimal @default(0) @db.Decimal(10, 2)
  satRatValue                Decimal @default(0) @db.Decimal(10, 2)
  irpfValue                  Decimal @default(0) @db.Decimal(10, 2)
  custasJudiciaisValue       Decimal @default(0) @db.Decimal(10, 2)
  honorariosSucumbenciaValue Decimal @default(0) @db.Decimal(10, 2)
  honorariosIrpfValue        Decimal @default(0) @db.Decimal(10, 2)
  honorariosLiquidosValue    Decimal @default(0) @db.Decimal(10, 2)
  brutoDevidoReclamante      Decimal @default(0) @db.Decimal(10, 2)
  totalDescontos             Decimal @default(0) @db.Decimal(10, 2)
  liquidoDevidoReclamante    Decimal @default(0) @db.Decimal(10, 2)
  totalDevidoReclamado       Decimal @default(0) @db.Decimal(10, 2)
  percentualRemuneratorio    Decimal @default(0) @db.Decimal(10, 2)

  // New verbas: art. 467, prescrição quinquenal, diferenças salariais, outras verbas
  applyArt467                   Boolean               @default(false)
  applyPrescricaoQuinquenal     Boolean               @default(false)
  prescricaoCutoff              DateTime?
  salaryDifferenceType          SalaryDifferenceType?
  paradigmName                  String?
  salaryDifferenceApplyReflexos Boolean               @default(true)
  art467Value                   Decimal               @default(0) @db.Decimal(10, 2)
  salaryDifferenceValue         Decimal               @default(0) @db.Decimal(10, 2)
  salaryDifferenceReflexosValue Decimal               @default(0) @db.Decimal(10, 2)
  outrasVerbasValue             Decimal               @default(0) @db.Decimal(10, 2)
  customVerbasReflexosValue     Decimal               @default(0) @db.Decimal(10, 2)
  intervalIntrajornadaHours     Int                   @default(0)
  transferAdditionalMonths      Int                   @default(0)
  intervalIntrajornadaValue     Decimal               @default(0) @db.Decimal(10, 2)
  transferAdditionalValue       Decimal               @default(0) @db.Decimal(10, 2)
  applyDsrOnExtra               Boolean               @default(false)
  stabilityMonths               Int                   @default(0)
  fgtsAlreadyDeposited          Decimal               @default(0) @db.Decimal(10, 2)
  amountsAlreadyPaid            Decimal               @default(0) @db.Decimal(10, 2)
  dsrValue                      Decimal               @default(0) @db.Decimal(10, 2)
  stabilityValue                Decimal               @default(0) @db.Decimal(10, 2)
  deductionsValue               Decimal               @default(0) @db.Decimal(10, 2)

  // Provenance. Null on calculations created before this was tracked — the UI
  // must say "procedência não registrada" rather than imply a snapshot exists.
  indexSnapshotId  String?
  indexSnapshot    IndexTableSnapshot? @relation(fields: [indexSnapshotId], references: [id])
  // Version of the calculation engine that produced the stored results.
  engineVersion    String?
  // Last time the user explicitly re-ran the calculation against fresh indices.
  indexesUpdatedAt DateTime?

  fgtsEntries             FgtsMonthlyEntry[]
  verbaLines              CalculationVerbaLine[]
  salaryHistory           SalaryHistory[]
  unpaidSalaries          UnpaidSalary[]
  salaryDifferencePeriods SalaryDifferencePeriod[]
  salaryDifferenceEntries SalaryDifferenceEntry[]
  customVerbas            CustomVerba[]

  settlements Settlement[]

  @@index([userId])
  @@index([shareCode])
  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([caseId])
  @@index([organizationId])
  @@index([indexSnapshotId])
}

model FgtsMonthlyEntry {
  id String @id @default(cuid())

  laborCalculationId String
  laborCalculation   LaborCalculation? @relation(fields: [laborCalculationId], references: [id], onDelete: Cascade)

  month            DateTime
  base             Float
  aliquot          Float
  deposit          Float
  corrected        Float
  correctionAmount Float
  interest         Float
  total            Float

  createdAt DateTime @default(now())

  @@unique([laborCalculationId, month])
  @@index([laborCalculationId])
}

// Memória de cálculo: uma linha por verba, como sai do motor. Sem isso o
// demonstrativo teria de ser recalculado a cada emissão de laudo, e recalcular
// é justamente o que se quer evitar depois que o cálculo foi fechado.
// `legalRef` nasce nulo — preenchido quando as verbas ganharem fundamento
// (adicionais ainda entram embutidos em agregados).
model CalculationVerbaLine {
  id String @id @default(cuid())

  laborCalculationId String
  laborCalculation   LaborCalculation @relation(fields: [laborCalculationId], references: [id], onDelete: Cascade)

  // Posição na memória de cálculo, na ordem em que o motor emite.
  order    Int
  name     String
  legalRef String?

  bruto     Decimal @db.Decimal(12, 2)
  corrigido Decimal @db.Decimal(12, 2)
  juros     Decimal @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@unique([laborCalculationId, order])
  @@index([laborCalculationId])
}

model SalaryHistory {
  id String @id @default(cuid())

  laborCalculationId String
  laborCalculation   LaborCalculation? @relation(fields: [laborCalculationId], references: [id], onDelete: Cascade)

  month      DateTime
  baseSalary Float
  lastSalary Float

  createdAt DateTime @default(now())

  @@unique([laborCalculationId, month])
  @@index([laborCalculationId])
}

model UnpaidSalary {
  id String @id @default(cuid())

  laborCalculationId String
  laborCalculation   LaborCalculation? @relation(fields: [laborCalculationId], references: [id], onDelete: Cascade)

  month      DateTime
  daysWorked Int

  createdAt DateTime @default(now())

  @@unique([laborCalculationId, month])
  @@index([laborCalculationId])
}

// Input: lawyer-defined salary difference periods (equiparação / desvio de função)
model SalaryDifferencePeriod {
  id String @id @default(cuid())

  laborCalculationId String
  laborCalculation   LaborCalculation? @relation(fields: [laborCalculationId], references: [id], onDelete: Cascade)

  startMonth     DateTime
  endMonth       DateTime
  dueSalary      Float
  receivedSalary Float?

  createdAt DateTime @default(now())

  @@index([laborCalculationId])
}

// Computed: month-by-month salary difference breakdown (court spreadsheet)
model SalaryDifferenceEntry {
  id String @id @default(cuid())

  laborCalculationId String
  laborCalculation   LaborCalculation? @relation(fields: [laborCalculationId], references: [id], onDelete: Cascade)

  month            DateTime
  due              Float
  received         Float
  diff             Float
  corrected        Float
  correctionAmount Float
  interest         Float
  total            Float

  createdAt DateTime @default(now())

  @@unique([laborCalculationId, month])
  @@index([laborCalculationId])
}

// Input + computed aggregates: lawyer-defined custom verbas
model CustomVerba {
  id String @id @default(cuid())

  laborCalculationId String
  laborCalculation   LaborCalculation? @relation(fields: [laborCalculationId], references: [id], onDelete: Cascade)

  name         String
  monthlyValue Float
  startMonth   DateTime
  endMonth     DateTime
  nature       CustomVerbaNature @default(indenizatoria)

  brutoValue     Float @default(0)
  correctedValue Float @default(0)
  interestValue  Float @default(0)
  totalValue     Float @default(0)

  createdAt DateTime @default(now())

  @@index([laborCalculationId])
}

enum SalaryDifferenceType {
  equiparacao
  desvio_funcao
}

enum CustomVerbaNature {
  indenizatoria
  salarial
}

enum TerminationType {
  sem_justa_causa
  com_justa_causa
  pedido_demissao
  rescisao_indireta
}

enum CalculationStatus {
  em_andamento
  proposta_enviada
  acordo_fechado
  ajuizado
}

enum SettlementFeeType {
  percentage
  fixed
}

enum SettlementStatus {
  negotiating
  accepted
  rejected
}

model Settlement {
  id String @id @default(cuid())

  laborCalculationId String
  laborCalculation   LaborCalculation @relation(fields: [laborCalculationId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  agreementRate Decimal           @db.Decimal(10, 2)
  feeType       SettlementFeeType @default(percentage)
  feeValue      Decimal           @db.Decimal(10, 2)

  agreementValue Decimal @db.Decimal(10, 2)
  feeAmount      Decimal @db.Decimal(10, 2)
  netToClient    Decimal @db.Decimal(10, 2)
  estimatedTime  String

  status    SettlementStatus @default(negotiating)
  settledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  installments SettlementInstallment[]

  @@index([laborCalculationId])
  @@index([laborCalculationId, status])
  @@index([organizationId])
}

// Installment schedule of an accepted settlement (parcelas do acordo).
model SettlementInstallment {
  id           String    @id @default(cuid())
  settlementId String
  number       Int
  dueDate      DateTime
  amount       Decimal   @db.Decimal(12, 2)
  paidAt       DateTime?
  createdAt    DateTime  @default(now())

  settlement Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([settlementId])
  @@index([dueDate])
  @@index([organizationId])
}

model MonetaryIndex {
  id String @id @default(cuid())

  month           DateTime @unique
  // 8 decimals: monthly TR (0.1709) and cumulative factors (1.00420000) need
  // more than 2 places or correction/interest drift.
  ipcaE           Decimal  @db.Decimal(18, 8)
  ipcaECumulative Decimal  @db.Decimal(18, 8)
  selic           Decimal  @db.Decimal(18, 8)
  selicCumulative Decimal  @db.Decimal(18, 8)
  trd             Decimal  @db.Decimal(18, 8)

  // Origin of the row: 'bcb' (auto-synced) or 'manual' (admin override).
  source    String   @default("manual")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Frozen copy of the correction index table used by a calculation. MonetaryIndex
// is global and mutable — without a snapshot, editing a saved calculation would
// silently reapply whatever indices exist today and move the total. Rows are
// deduplicated by `hash`, so thousands of calculations sharing the same table
// point at a single row.
model IndexTableSnapshot {
  id String @id @default(cuid())

  // sha256 of the canonical serialization of `entries` (see index-snapshot.ts).
  hash String @unique

  // IndexEntry[] exactly as consumed by createIndexTable().
  entries Json

  // Denormalized for display and diagnostics; derived from `entries`.
  entryCount Int
  minMonth   String
  maxMonth   String

  createdAt DateTime @default(now())

  calculations LaborCalculation[]

  @@index([createdAt])
}

// Trilha de auditoria. Responde "por que esse número" quando a parte contrária
// impugna ou um cliente corporativo audita: quem mexeu, quando, o que mudou.
// Escrita best-effort — falha aqui não pode derrubar a operação principal.
model AuditLog {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Nulo em contexto de sistema (cron, webhook).
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  entityType String // "LaborCalculation"
  entityId   String
  action     String // create | update | reindex | delete | status_change

  // { campo: { from, to } }, só os campos que mudaram.
  changes Json?

  createdAt DateTime @default(now())

  @@index([organizationId, entityType, entityId, createdAt])
  @@index([organizationId, createdAt])
}

model RefreshToken {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String   @unique
  family    String
  isRevoked Boolean  @default(false)
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([family])
  @@index([tokenHash])
}

enum CasePhase {
  pre_judicial
  distribuido
  conhecimento
  recurso
  execucao
  encerrado
}

model Case {
  id                 String      @id @default(cuid())
  assignedToId       String
  organizationId     String
  clientId           String?
  title              String
  processNumber      String?
  court              String?
  vara               String?
  phase              CasePhase   @default(pre_judicial)
  actionType         ActionType?
  valorCausa         Decimal?    @db.Decimal(12, 2)
  riskLevel          RiskLevel?
  observations       String?
  openedAt           DateTime    @default(now())
  closedAt           DateTime?
  /// Última consulta ao DataJud. Dá ao cron a ordem de rodízio — a API pública
  /// do CNJ tem limite, então cada rodada atende um pedaço da fila.
  lastMovementSyncAt DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  deletedAt          DateTime?

  assignedTo           User                  @relation(fields: [assignedToId], references: [id])
  organization         Organization          @relation(fields: [organizationId], references: [id])
  client               Client?               @relation(fields: [clientId], references: [id])
  calculations         LaborCalculation[]
  hearings             Hearing[]
  deadlines            Deadline[]
  documents            Document[]
  notes                Note[]
  messages             Message[]
  activities           Activity[]
  documentRequirements DocumentRequirement[]
  timelineEvents       TimelineEvent[]
  parties              CaseParty[]
  tasks                CaseTask[]
  movements            CaseMovement[]
  feeAgreement         FeeAgreement?
  signatureRequests    SignatureRequest[]

  @@index([assignedToId])
  @@index([assignedToId, phase])
  @@index([assignedToId, createdAt])
  @@index([processNumber])
  @@index([organizationId])
  @@index([lastMovementSyncAt])
}

enum ActionType {
  verbas_rescisorias
  horas_extras
  equiparacao_salarial
  desvio_funcao
  danos_morais
