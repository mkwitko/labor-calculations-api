enum ClientTokenPurpose {
  invite
  reset
}

// One-time link the client uses to set a portal password — on first access
// (invite) or after forgetting it (reset). Replaces two bad practices: the
// initial password derived from the CPF, and the reset token that used to be
// serialized into `Client.notes`, overwriting the lawyer's own annotations.
model ClientAccessToken {
  id        String             @id @default(cuid())
  clientId  String
  tokenHash String             @unique
  purpose   ClientTokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime           @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([clientId, purpose])
  @@index([expiresAt])
  @@index([organizationId])
}

// Local mirror of the user's Stripe subscription, written only by the Stripe
// webhook. Reading billing state from the database instead of the Stripe API
// keeps route guards fast and keeps the app usable when Stripe is unreachable.
model Subscription {
  id                   String    @id @default(cuid())
  organizationId       String    @unique
  stripeSubscriptionId String    @unique
  stripeCustomerId     String
  status               String
  priceId              String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  trialEnd             DateTime?
  firstPaidAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([stripeCustomerId])
}

/// Credencial de integração da organização. O segredo nunca é gravado: fica o
/// sha256, como em `invite-token.ts`.
/// `test` calcula igual a `live` e **não** gera cobrança: existe para o
/// integrador escrever a integração sem queimar chamada paga.
enum ApiKeyMode {
  live
  test
}

model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  mode           ApiKeyMode @default(live)
  /// Parte visível do token ("jp_live_" + 16 hex), única e indexada: é por ela
  /// que a chave é encontrada antes de o segredo ser verificado.
  prefix         String    @unique
  secretHash     String
  /// Quem emitiu. Vira o `userId` do cálculo criado pela chave, porque
  /// `LaborCalculation.userId` é obrigatório e a chamada não tem pessoa.
  createdById    String
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  createdBy    User         @relation(fields: [createdById], references: [id])
  usages       ApiUsage[]

  @@index([organizationId])
}

/// Uma linha por chamada cobrável. `reportedAt` nulo = ainda não reportada ao
/// medidor do Stripe.
model ApiUsage {
  id             String    @id @default(cuid())
  organizationId String
  apiKeyId       String
  endpoint       String
  calculationId  String?
  createdAt      DateTime  @default(now())
  reportedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  apiKey       ApiKey       @relation(fields: [apiKeyId], references: [id])

  @@index([organizationId, createdAt])
  @@index([reportedAt])
}

enum ReferralTier {
  none
  bronze
  prata
  ouro
  diamante
}

enum ReferralStatus {
  pending
  signed_up
  qualified
  lost
}

// One row per invitation. It is the state machine of the referral program:
// created on invite or signup, promoted to `qualified` when the referee pays a
// real invoice, demoted to `lost` when they cancel or get refunded.
model Referral {
  id         String  @id @default(cuid())
  referrerId String
  refereeId  String? @unique

  inviteEmail String?
  status      ReferralStatus @default(pending)

  signedUpAt  DateTime?
  qualifiedAt DateTime?
  lostAt      DateTime?

  // Amount of the referee's first paid invoice, in cents. Frozen at
  // qualification time — it is the base of the cashback credited at D+30.
  firstPaidAmountCents Int?
  cashbackPaidAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  referrer User  @relation("referrerLink", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User? @relation("refereeLink", fields: [refereeId], references: [id], onDelete: SetNull)

  @@index([referrerId, status])
  @@index([status, cashbackPaidAt])
}

// Cálculo feito por alguém sem conta, na calculadora pública. Não é tenant: não
// pertence a organização nenhuma enquanto um advogado não o reivindicar. Os
// campos de reivindicação já entram aqui, nulos — adicionar coluna nula depois é
// barato, migrar tabela com dados em produção não é.
model PublicCalculation {
  id        String  @id @default(cuid())
  tokenHash String  @unique
  name      String?
  email     String?
  phone     String?

  input           Json
  result          Json
  engineVersion   String
  indexSnapshotId String?

  source       String
  referrerHost String?

  /// Organização dona do widget que originou o cálculo. Dentro do iframe o
  /// Referer é o nosso próprio host, então `referrerHost` não serve para
  /// atribuir — quem atribui é a chave do widget, validada no servidor.
  widgetOrganizationId String?

  /// "trabalhador" (quanto tenho a receber) ou "empresa" (quanto custa demitir).
  /// O motor é o mesmo; muda a leitura do resultado.
  perspective String @default("trabalhador")

  /// Qual calculadora gerou este registro: "rescisao" (wizard de sete passos),
  /// "horas_extras" ou "ferias_13". Determina qual motor produziu `result` e
  /// qual tela o front monta. O default preserva as linhas já existentes.
  kind String @default("rescisao")

  invitedEmail String?
  invitedAt    DateTime?

  claimedByOrganizationId String?
  claimedAt               DateTime?
  clientId                String?
  laborCalculationId      String?

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([email])
  @@index([claimedByOrganizationId])
  @@index([expiresAt])
  @@index([perspective])
  @@index([kind, createdAt])
  @@index([widgetOrganizationId, createdAt])
}

// Avaliação de passivo trabalhista de uma folha inteira. O motor é o mesmo
// `calculateLaborV3`; o que este modelo acrescenta é a agregação por empresa e a
// leitura de empregador (custo de desligar × exposição em reclamação).
model BatchAssessment {
  id     String @id @default(cuid())
  name   String
  userId String
  user   User   @relation(fields: [userId], references: [id])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // A empresa avaliada, quando ela já é cliente do escritório.
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  // Uma tabela de índices para o lote inteiro: comparar exposições calculadas
  // com tabelas diferentes não significaria nada.
  indexSnapshotId String?
  engineVersion   String

  rowCount    Int @default(0)
  failedCount Int @default(0)

  severanceCost Decimal @default(0) @db.Decimal(14, 2)
  exposure      Decimal @default(0) @db.Decimal(14, 2)
  gap           Decimal @default(0) @db.Decimal(14, 2)

  rows BatchAssessmentRow[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organizationId, createdAt])
  @@index([clientId])
}

model BatchAssessmentRow {
  id      String          @id @default(cuid())
  batchId String
  batch   BatchAssessment @relation(fields: [batchId], references: [id], onDelete: Cascade)

  order     Int
  /// Como a empresa identifica a pessoa: matrícula, nome, o que vier no arquivo.
  reference String
  input     Json

  severanceCost Decimal? @db.Decimal(14, 2)
  exposure      Decimal? @db.Decimal(14, 2)
  gap           Decimal? @db.Decimal(14, 2)

  /// Preenchido quando a linha não pôde ser calculada. Linha ruim não derruba o lote.
  error String?

  @@index([batchId, order])
}

/// Canal de atendimento entre o escritório e o LexLaboral.
///
/// É um só modelo para dúvida, problema e sugestão porque os três têm a mesma
/// forma — alguém escreve, alguém responde, o assunto anda até acabar. O que
/// muda é o vocabulário do status na tela, e isso é rótulo, não estrutura.
///
/// Pertence à **organização**, não à pessoa: quem abriu pode sair do escritório
/// no meio da conversa, e o chamado continua sendo do escritório.
model SupportTicket {
  id      String        @id @default(cuid())
  kind    SupportKind
  status  SupportStatus @default(aberto)
  subject String
  /// Rota, plano e versão de onde o chamado saiu. Evita a primeira rodada de
  /// perguntas ("em que tela foi?", "qual o seu plano?") em todo atendimento.
  context Json?

  /// Quem abriu. Fica nulo se a pessoa for removida — o chamado sobrevive.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  messages SupportMessage[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  /// Ordena a fila do atendimento sem varrer as mensagens de cada chamado.
  lastMessageAt DateTime  @default(now())
  closedAt      DateTime?

  @@index([organizationId, lastMessageAt])
  @@index([status, lastMessageAt])
  @@index([userId])
}

/// Uma fala dentro do chamado. `fromStaff` distingue quem escreveu: o LexLaboral
/// responde sem usuário associado, então autor nulo não significa "anônimo".
model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  body      String
  fromStaff Boolean       @default(false)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt     DateTime  @default(now())
  /// Marcações de leitura dos dois lados, para o contador de não lidas.
  readByUserAt  DateTime?
  readByStaffAt DateTime?

  attachments SupportAttachment[]

  @@index([ticketId, createdAt])
  @@index([organizationId])
}

/// Arquivo anexado a uma fala do chamado — print da tela, vídeo do erro, PDF.
///
/// Não reaproveita `Document`: documento pertence a um caso e aparece na pasta
/// do cliente, e print de suporte não é peça do processo. Guarda só a chave do
/// R2; a URL de leitura é assinada na hora, nunca persistida.
model SupportAttachment {
  id        String         @id @default(cuid())
  messageId String
  message   SupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  fileKey   String
  fileName  String
  mimeType  String
  sizeBytes Int

  /// Resultado da varredura antivírus: `pending` enquanto não houve varredura,
  /// `clean` liberado, `infected` bloqueado no download. Sem clamd configurado
  /// fica `skipped` — declarar que não houve varredura é melhor que fingir que
  /// houve.
  scanStatus SupportScanStatus @default(pending)
  scanDetail String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())

  @@index([messageId])
  @@index([organizationId])
}

enum SupportScanStatus {
  pending
  clean
  infected
  skipped
}

enum SupportKind {
  duvida
  problema
  sugestao
}

/// Um enum para os dois fluxos. O chamado usa aberto → em_analise →
/// aguardando_usuario → concluido; a sugestão usa aberto → em_analise →
/// planejado → em_desenvolvimento → concluido. `recusado` fecha os dois.
/// A tela traduz: `concluido` é "resolvido" no chamado e "entregue" na sugestão.
enum SupportStatus {
  aberto
  em_analise
  aguardando_usuario
  planejado
  em_desenvolvimento
  concluido
  recusado
}
